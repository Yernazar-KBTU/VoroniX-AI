{
  "name": "voronix-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoroniX AI: our own small language model that understands what a salon client wants (Russian, Kazakh, English), served over an HTTP API.",
  "author": "Altynbekov Yernazar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yernazar-KBTU/voronix-ai.git"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "train": "tsx src/train-cli.ts",
    "build:demo": "tsx scripts/build-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:brain": "tsx scripts/build-brain.ts",
    "generate": "tsx scripts/generate-phrases.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
